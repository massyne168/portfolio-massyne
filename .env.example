# Cloudflare R2 Media Storage Configuration
# Configure these variables in Vercel (Preview / Production) and GitHub Actions Secrets.
# NEVER commit real secret values to Git or store them in public repositories.

# Cloudflare Account ID (32-character hex string)
MASSYNE_R2_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare R2 S3-Compatible Credentials (generated via R2 API Token)
MASSYNE_R2_ACCESS_KEY_ID=your_r2_access_key_id
MASSYNE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2 Bucket Name
MASSYNE_R2_BUCKET=massyne-portfolio-01

# Public HTTPS URL serving R2 bucket media (e.g. https://pub-xxxxxx.r2.dev or custom media domain)
# Exclude trailing slash.
MASSYNE_R2_PUBLIC_URL=https://pub-c78e3daeef5841a99f5ce6ad0ebd9fdf.r2.dev

# MASSYNE Studio Configuration & Branch Protection
# Protects production by preventing Studio from committing directly to 'main' in Preview environments.
MASSYNE_STUDIO_ACCESS_CODE=your_studio_access_code
MASSYNE_STUDIO_GITHUB_TOKEN=your_github_personal_access_token_or_fine_grained_token
MASSYNE_STUDIO_GITHUB_BRANCH=feat/r2-performance-optimization
