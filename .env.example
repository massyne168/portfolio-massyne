# Cloudflare R2 — configure these as Vercel Production environment variables.
# Never commit real values. Create an R2 API token with Object Read & Write
# scoped only to the portfolio media bucket.
MASSYNE_R2_ACCOUNT_ID=
MASSYNE_R2_ACCESS_KEY_ID=
MASSYNE_R2_SECRET_ACCESS_KEY=
MASSYNE_R2_BUCKET=
# Public HTTPS custom domain attached to the R2 bucket, e.g. https://media.example.com
MASSYNE_R2_PUBLIC_URL=

# Existing Studio secrets (keep these in Vercel, not in this file).
MASSYNE_STUDIO_ACCESS_CODE=
MASSYNE_STUDIO_GITHUB_TOKEN=
